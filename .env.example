# ---------- Telegram: your user account (reads the signal group) ----------
# Get these at https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION=signal_listener
# Group/channel to copy signals from: @username or numeric ID (comma-separate several).
# Run `python -m signalbot.main --list-chats` to find the ID.
SIGNAL_CHATS=-1001234567890

# ---------- Telegram: control bot (optional, recommended) ----------
# Create with @BotFather. If empty, notifications go to your Saved Messages.
BOT_TOKEN=
# Your Telegram numeric user ID (from @userinfobot). Defaults to the logged-in account.
OWNER_ID=

# ---------- Deriv ----------
# https://app.deriv.com/account/api-token  -> scopes: Read + Trade
# Use a DEMO (VRTC...) account token first!
DERIV_TOKEN=
# Register your own app at https://api.deriv.com/dashboard (1089 = public test app)
DERIV_APP_ID=1089
CURRENCY=USD

# ---------- Money management ----------
BASE_STAKE=1
# Payout on Rise/Fall is ~85-95%, so 2.0 does NOT fully recover; 2.2 roughly does.
MARTINGALE_MULTIPLIER=2.2
MAX_MARTINGALE_STEPS=3
# Refuse any single trade above this amount
MAX_STAKE=50
# Stop trading for the day (UTC) once net loss reaches this. 0 = off
DAILY_LOSS_LIMIT=50
# Stop trading for the day once net profit reaches this. 0 = off
DAILY_PROFIT_TARGET=0
# Seconds after the entry time a trade may still be placed
LATE_ENTRY_TOLERANCE=20
# true = log what would be traded without buying anything
DRY_RUN=true
